<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target to support older frameworks and .NET 6+ if needed. -->
    <TargetFrameworks>net472;net6.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Optimizely.Performance Contributors</Authors>
    <Description>Optimizely Performance ServiceBus - unified assembly for CMS 11/12/13 variants (use conditional compilation symbols CMS11, CMS12, or CMS13)</Description>
    <PackageTags>Optimizely;Performance;ServiceBus;MessagePriority</PackageTags>
    <RootNamespace>Optimizely.Performance.ServiceBus</RootNamespace>
    <PackageId>Optimizely.Performance.ServiceBus</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <!-- EPiServer.Framework reference - version depends on target framework -->
    <PackageReference Include="EPiServer.Framework" Version="11.20.14" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="EPiServer.Framework" Version="12.24.1" Condition="'$(TargetFramework)' == 'net6.0'" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimizely.Performance.ServiceBus.Core\Optimizely.Performance.ServiceBus.Core.csproj" />
  </ItemGroup>

</Project>
