<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>OptiServiceBusPrioritizer Contributors</Authors>
    <Description>Service Bus message prioritization for Optimizely CMS 12</Description>
    <PackageTags>Optimizely;CMS12;ServiceBus;Azure;MessagePriority</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Optimizely packages will be referenced by consuming projects -->
    <PackageReference Include="WindowsAzure.ServiceBus" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptiServiceBusInterceptor.Core\OptiServiceBusPrioritizer.Core.csproj" />
  </ItemGroup>

</Project>
